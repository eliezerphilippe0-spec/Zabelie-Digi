# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# Tout fichier d'environnement est ignoré, SAUF le gabarit vide.
# `.env` + `.env*.local` laissait passer `.env.development`, `.env.production`
# et `.env.test` — que Next.js lit pourtant, et qu'on crée pour essayer la
# prod en local. Vérifié par `git check-ignore` : les trois étaient suivis.
# La forme large + exception ne peut pas se faire déborder par un variant
# futur, contrairement à une liste qu'il faut penser à compléter.
.env*
!.env.example

# typescript
*.tsbuildinfo

# vercel
.vercel

# playwright
/test-results
/playwright-report
/playwright/.cache

# Scripts d'outillage de session (audits Playwright jetables)
.zabelie-*.tmp.mjs

# ops/ : seuls les agrégats entrent dans git — le journal d'apurement
# (identifiants, numéros MonCash, références de virement) reste HORS dépôt.
ops/apurement*
ops/**/apurement*
