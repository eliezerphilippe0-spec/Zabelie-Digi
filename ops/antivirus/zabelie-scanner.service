[Unit]
Description=Zabelie private digital file scanner
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=zabelie-scanner
Group=zabelie-scanner
WorkingDirectory=/opt/zabelie-scanner
LoadCredential=scanner.env:/etc/zabelie-scanner/scanner.env
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
LimitCORE=0
MemoryMax=4G
TasksMax=64
TimeoutStartSec=45min
TimeoutStopSec=20s
KillMode=control-group
StandardOutput=journal
StandardError=journal
StateDirectory=zabelie-scanner
StateDirectoryMode=0700
ExecStart=/usr/bin/node --env-file=%d/scanner.env --import tsx scripts/scanner-fichiers.ts --apply
# Only a successful complete run refreshes this operational heartbeat.
ExecStartPost=/usr/bin/touch /var/lib/zabelie-scanner/last-success
